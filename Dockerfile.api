# =============================================================================
# Dockerfile for the API + crawler worker (shared image)
# =============================================================================
FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# System deps for lxml, psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies first (better layer caching)
COPY pyproject.toml ./
RUN pip install --upgrade pip && \
    pip install \
      "fastapi>=0.110.0" \
      "uvicorn[standard]>=0.27.0" \
      "sqlalchemy>=2.0.25" \
      "psycopg2-binary>=2.9.9" \
      "httpx>=0.27.0" \
      "tenacity>=8.2.3" \
      "beautifulsoup4>=4.12.3" \
      "lxml>=5.1.0" \
      "bleach>=6.1.0" \
      "bcrypt>=4.1.2" \
      "python-multipart>=0.0.9" \
      "click>=8.1.7" \
      "rich>=13.7.0" \
      "pydantic>=2.6.0" \
      "pydantic-settings>=2.1.0" \
      "python-dotenv>=1.0.1" \
      "pyyaml>=6.0.1" \
      "slowapi>=0.1.9" \
      "jinja2>=3.1.3" \
      "itsdangerous>=2.1.2"

# Copy application code
COPY crawler/ ./crawler/
COPY api/     ./api/
COPY database/ ./database/
COPY cli/     ./cli/
COPY config/  ./config/
COPY __main__.py ./
COPY scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Persistent volumes mounted at runtime:
#   - /data         (SQLite DB if used)
#   - /app/archive  (archive files)
#   - /app/logs     (log files)

ENV ARCHIVE_DIR=/app/archive \
    DATA_DIR=/data \
    LOG_DIR=/app/logs

RUN mkdir -p /data /app/archive /app/logs

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["serve"]
