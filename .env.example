# =============================================================================
# MathVault Configuration
# =============================================================================
# Copy this file to `.env` and edit values. NEVER commit `.env` to git.

# --- Archive allowlist (CRITICAL — Crawler never fetches outside these) ------
# Comma-separated list of domains. Subdomains allowed only if explicit.
ARCHIVE_ALLOWED_DOMAINS=example.com,archive.example.edu

# Comma-separated path prefixes. Crawler only follows URLs starting with one.
# Use empty value to allow all paths on allowed domains (NOT recommended).
ARCHIVE_ALLOWED_PATH_PREFIXES=/contests/,/problems/,/resources/,/assets/

# Start URLs for crawl discovery (comma-separated, fully qualified)
ARCHIVE_START_URLS=https://example.com/contests/

# --- Crawl behavior -----------------------------------------------------------
CRAWL_MAX_DEPTH=5
CRAWL_MAX_PAGES=1000
CRAWL_DELAY_SECONDS=2
CRAWL_CONCURRENCY=1
CRAWL_TIMEOUT_SECONDS=30
CRAWL_MAX_RETRIES=3
CRAWL_USER_AGENT=MathVault-Archiver/1.0 (+https://your-server.tld/mathvault)
CRAWL_RESPECT_ROBOTS=true

# --- Sync schedule ------------------------------------------------------------
SYNC_INTERVAL_HOURS=2

# --- Database -----------------------------------------------------------------
# SQLite (development):
DATABASE_URL=sqlite:///./data/mathvault.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://mathvault:CHANGE_ME@mathvault-db:5432/mathvault

# Run mode for DB-specific behavior (sqlite | postgres)
DB_ENGINE=sqlite

# --- Security -----------------------------------------------------------------
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_HEX_STRING_AT_LEAST_32_BYTES
ADMIN_USERNAME=admin
# Generate with: python -c "import secrets;print(secrets.token_hex(16))"
ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# --- Storage -------------------------------------------------------------------
ARCHIVE_DIR=./archive
DATA_DIR=./data
LOG_DIR=./logs

# --- API -----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
# Comma-separated trusted proxies for X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1

# --- Frontend -----------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
