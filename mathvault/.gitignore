# Server Manager — local seed file (contains plaintext SSH passwords)
server-manager/scripts/servers.local.json

# Authorization evidence files (NEVER commit — may contain personal info)
sources/*/evidence/

# Database
*.db
*.db-journal
*.sqlite
*.sqlite-journal
data/

# Browser session storage (cookies, localStorage) — NEVER commit
data/browser_session/

# Archive contents (NEVER commit — these are local-only)
archive/pages/
archive/assets/
archive/index/

# Logs
logs/
*.log

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
