# =============================================================================
# Personal Server Manager — Configuration
# =============================================================================
# Copy this file to `.env` and edit values. NEVER commit `.env`.

# --- App ------------------------------------------------------------------
APP_HOST=127.0.0.1      # bind to localhost only — this app runs on YOUR laptop
APP_PORT=7700
APP_DEBUG=true

# --- Database (local SQLite only — never expose this DB) ------------------
DATABASE_URL=sqlite:///./data/server-manager.db

# --- Master password for encrypting SSH credentials -----------------------
# The master password is NOT stored in .env. Instead, it is set interactively
# on first run via the CLI: `server-manager set-master-password`
# The HASH of the master password is stored in DB; the actual password is
# kept in memory only while the app is running.
# After running setup.py, this line will be ADDED at the end of .env:
#   MASTER_PASSWORD_HASH=$2b$12$...
# (Leave the line below commented out until setup.py fills it in.)
# MASTER_PASSWORD_HASH=

# --- Encryption -----------------------------------------------------------
# Use age-style encryption (libsodium sealed box via PyNaCl)
# A keypair is generated automatically on first run and stored in data/keypair.json
# The private key is itself encrypted with the master password.

# --- SSH defaults ---------------------------------------------------------
SSH_DEFAULT_PORT=22
SSH_DEFAULT_USER=root
SSH_CONNECT_TIMEOUT=15

# --- Reverse proxy (optional) ---------------------------------------------
# If you run a reverse proxy in front of MathVault, set its URL here for
# convenient access from the Server Manager UI
MATHVAULT_FRONTEND_URL=http://localhost:3000
MATHVAULT_API_URL=http://localhost:8000
